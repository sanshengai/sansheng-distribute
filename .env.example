# Optional configuration pointers. Defaults are discovered automatically.
# The program does not automatically load this file.
# SANSHENG_DISTRIBUTE_PROFILE=/absolute/private/path/profile.json
# SANSHENG_DISTRIBUTE_STATE=/absolute/private/path/state

# Only required for the optional WeChat Official Account API adapter.
# Provide these through process environment or a private env file referenced
# by accounts.<alias>.wechat_env_file in your private profile.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
